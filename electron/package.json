{
    "name": "port2you-driver-nav",
    "productName": "Port2You DriverNav",
    "version": "0.5.0",
    "description": "Port2You DriverNav - navigation, telemetry and driver tools for ETS2 and ATS.",
    "author": {
        "name": "Port2You"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lucky13linux/Port2You-DriverNav"
    },
    "license": "GPL-3.0",
    "main": "build/src/index.js",
    "scripts": {
        "build": "tsc && electron-rebuild",
        "electron:start-live": "node ./live-runner.js",
        "electron:start": "npm run build && electron --inspect=5858 ./",
        "electron:pack": "npm run build && electron-builder build --dir -c ./electron-builder.config.json",
        "electron:make": "npm run build && electron-builder build -c ./electron-builder.config.json"
    },
    "dependencies": {
        "@capacitor-community/electron": "^5.0.0",
        "axios": "^1.16.1",
        "chokidar": "~3.5.3",
        "discord-rpc": "^4.0.1",
        "electron-is-dev": "~2.0.0",
        "electron-serve": "~1.1.0",
        "electron-unhandled": "~4.0.1",
        "electron-updater": "^6.6.2",
        "electron-window-state": "^5.0.3",
        "express": "^5.2.1",
        "extract-zip": "^2.0.1",
        "native-reg": "^1.1.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^25.0.3",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "electron-rebuild": "^3.2.9",
        "typescript": "^5.0.4"
    },
    "keywords": [
        "capacitor",
        "electron",
        "port2you",
        "ets2",
        "ats",
        "navigation"
    ]
}